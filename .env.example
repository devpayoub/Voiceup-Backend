SECRET_KEY=change-me

# Local docker-compose uses these individual vars.
POSTGRES_DB=voiceup
POSTGRES_USER=voiceup
POSTGRES_PASSWORD=voiceup
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Render/Neon (or any hosted Postgres) instead set this single URL, which
# takes priority over the POSTGRES_* vars above when present.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
